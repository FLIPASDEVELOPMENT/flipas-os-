{
  "name": "flipas-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && node scripts/copy-static.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "tsx scripts/generate.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx prisma/seed.ts",
    "user:create": "tsx prisma/create-user.ts",
    "test:integration": "tsx --test tests/crm.integration.ts",
    "test:smoke": "tsx tests/http.smoke.ts",
    "env:local": "node scripts/create-local-env.mjs",
    "test:estimator": "tsx --test tests/estimator.integration.ts",
    "test:estimator:http": "tsx tests/estimator.http.ts",
    "test:owner": "tsx --test tests/owner.integration.ts",
    "test:owner:http": "tsx tests/owner.http.ts",
    "worker:ai": "tsx scripts/sales-worker.ts",
    "test:ai": "tsx --test tests/sales-ai.integration.ts",
    "test:ai:http": "tsx tests/sales-ai.http.ts",
    "env:mail": "node scripts/create-mail-key.mjs",
    "test:zoho": "tsx --test tests/zoho.integration.ts",
    "env:openai": "node scripts/create-openai-env.mjs",
    "test:openai": "tsx --test tests/openai-budget.integration.ts",
    "test:commercial": "tsx --test tests/commercial.integration.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "decimal.js": "^10.6.0",
    "next": "16.4.0",
    "openai": "7.30.1",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@prisma/client-generator-ts": "7.10.0",
    "@prisma/driver-adapter-utils": "7.10.0",
    "@prisma/internals": "7.10.0",
    "@prisma/schema-engine-wasm": "7.10.0-4.0edf323efd1d98336f3f0a68684b56f689b900d3",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.5"
  }
}

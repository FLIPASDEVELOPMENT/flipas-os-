generator client {
 provider = "prisma-client"
 output = "../src/generated/prisma"
}
datasource db {
 provider = "postgresql"
}
enum Role {
 OWNER
 ADMIN
 SALES
 PROJECT_MANAGER
 CREW
 CUSTOMER
}
enum LeadSource {
 WEBSITE
 INSTAGRAM
 FACEBOOK
 GOOGLE
 REFERRAL
 HOME_SHOW
 HOME_DEPOT
 THUMBTACK
 REALTOR
 INVESTOR
 REPEAT_CUSTOMER
 OTHER
}
enum LeadStatus {
 NEW
 CONTACTED
 QUALIFIED
 UNQUALIFIED
 CONVERTED
}
enum Stage {
 NEW
 CONTACTED
 QUALIFYING
 SITE_VISIT_SCHEDULED
 ESTIMATE_IN_PROGRESS
 ESTIMATE_SENT
 FOLLOW_UP
 NEGOTIATION
 WON
 LOST
}
enum ProjectStatus {
 PRE_CONSTRUCTION
 MATERIAL_ORDERING
 SCHEDULED
 IN_PROGRESS
 PUNCH_LIST
 COMPLETED
 CANCELLED
}
enum Risk {
 LOW
 MEDIUM
 HIGH
}
enum ActionStatus {
 PROPOSED
 AWAITING_APPROVAL
 APPROVED
 REJECTED
 EXECUTED
 FAILED
}
enum Unit {
 EACH
 SQFT
 LINEAR_FT
 HOUR
 DAY
 FLAT
}
model User {
 estimates Estimate[]
 estimateApprovals EstimateApproval[]
 pricingChanges CatalogPriceHistory[]

 id String @id @default(cuid())
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 email String @unique
 name String
 passwordHash String
 role Role @default(SALES)
 active Boolean @default(true)
 sessions Session[]
 leads Lead[]
 opportunities Opportunity[]
 activities Activity[]
 projects Project[]
 overrides EstimateLineItem[]
 approvals ApprovalRequest[]
}
model Session {
 id String @id @default(cuid())
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 tokenHash String @unique
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 expiresAt DateTime
 @@index([expiresAt])
}
model LoginAttempt {
 id String @id @default(cuid())
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 key String @unique
 count Int @default(0)
 windowStart DateTime @default(now())
}
model Customer {
 id String @id @default(cuid())
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 firstName String
 lastName String
 email String?
 phone String?
 address String?
 city String?
 state String @default("FL")
 zip String?
 notes String?
 leads Lead[]
 opportunities Opportunity[]
 activities Activity[]
 estimates Estimate[]
 projects Project[]
 @@index([lastName, firstName])
}
model Lead {
 id String @id @default(cuid())
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 customerId String
 customer Customer @relation(fields: [customerId], references: [id])
 source LeadSource
 serviceType String
 description String?
 status LeadStatus @default(NEW)
 leadScore Int @default(0)
 budgetMin Decimal? @db.Decimal(14,2)
 budgetMax Decimal? @db.Decimal(14,2)
 desiredStartDate DateTime?
 assignedToId String?
 assignedTo User? @relation(fields: [assignedToId], references: [id])
 opportunity Opportunity?
 activities Activity[]
 @@index([assignedToId, status])
}
model Opportunity {
 id String @id @default(cuid())
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 customerId String
 customer Customer @relation(fields: [customerId], references: [id])
 leadId String @unique
 lead Lead @relation(fields: [leadId], references: [id])
 stage Stage @default(NEW)
 estimatedValue Decimal? @db.Decimal(14,2)
 probability Int @default(0)
 nextAction String?
 nextActionDate DateTime?
 ownerId String
 owner User @relation(fields: [ownerId], references: [id])
 activities Activity[]
 estimates Estimate[]
 project Project?
 @@index([ownerId, stage])
}
model Activity {
 id String @id @default(cuid())
 createdAt DateTime @default(now())
 type String
 message String
 actorId String?
 actor User? @relation(fields: [actorId], references: [id])
 customerId String?
 customer Customer? @relation(fields: [customerId], references: [id])
 leadId String?
 lead Lead? @relation(fields: [leadId], references: [id])
 opportunityId String?
 opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
 metadata Json?
 @@index([customerId, createdAt])
 @@index([leadId, createdAt])
}
model ServiceCategory {
 id String @id @default(cuid())
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 name String @unique
 items ServiceItem[]
}
model ServiceItem {
 otherDirectCost Decimal @default(0) @db.Decimal(14,2)
 targetMargin Decimal @default(0) @db.Decimal(7,4)
 effectiveFrom DateTime @default(now())
 effectiveTo DateTime?
 history CatalogPriceHistory[]

 id String @id @default(cuid())
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 categoryId String
 category ServiceCategory @relation(fields: [categoryId], references: [id])
 name String
 description String?
 unit Unit
 materialCost Decimal @db.Decimal(14,2)
 laborCost Decimal @db.Decimal(14,2)
 subcontractorCost Decimal @db.Decimal(14,2)
 overheadAllocation Decimal @db.Decimal(14,2)
 defaultMarkup Decimal @db.Decimal(7,4)
 minimumMargin Decimal @db.Decimal(7,4)
 active Boolean @default(true)
 lines EstimateLineItem[]
}
model Estimate {
 number String? @unique
 seriesId String @default(cuid())
 revision Int @default(1)
 contentVersion Int @default(0)
 creatorId String?
 creator User? @relation(fields:[creatorId],references:[id])
 category String @default("General Remodeling")
 projectAddress String @default("")
 scope String @default("")
 notes String @default("")
 inclusions String @default("")
 exclusions String @default("")
 durationDays Int?
 expiresAt DateTime?
 paymentSchedule Json @default("[]")
 customerSnapshot Json @default("{}")
 businessSnapshot Json @default("{}")
 discountAmount Decimal @default(0) @db.Decimal(14,2)
 discountRate Decimal @default(0) @db.Decimal(7,4)
 significantDiscountThreshold Decimal @default(0) @db.Decimal(7,4)
 taxTreatment String @default("UNREVIEWED")
 taxRate Decimal @default(0) @db.Decimal(7,4)
 taxAmount Decimal @default(0) @db.Decimal(14,2)
 totalInvestment Decimal @default(0) @db.Decimal(14,2)
 allocatedOverhead Decimal @default(0) @db.Decimal(14,2)
 contributionProfit Decimal @default(0) @db.Decimal(14,2)
 approvalReasons Json @default("[]")
 acceptedAt DateTime?
 acceptanceReference String?
 approvals EstimateApproval[]
 @@unique([seriesId,revision])

 id String @id @default(cuid())
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 customerId String
 customer Customer @relation(fields: [customerId], references: [id])
 opportunityId String?
 opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
 status String @default("DRAFT")
 directCost Decimal @db.Decimal(14,2)
 sellingPrice Decimal @db.Decimal(14,2)
 grossProfit Decimal @db.Decimal(14,2)
 grossMargin Decimal @db.Decimal(7,4)
 sections EstimateSection[]
 projects Project[]
}
model EstimateSection {
 id String @id @default(cuid())
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 estimateId String
 estimate Estimate @relation(fields: [estimateId], references: [id])
 name String
 position Int
 lines EstimateLineItem[]
}
model EstimateLineItem {
 description String @default("")
 position Int @default(0)
 otherDirectCost Decimal @default(0) @db.Decimal(14,2)
 targetMargin Decimal @default(0) @db.Decimal(7,4)
 unitCost Decimal @default(0) @db.Decimal(14,2)
 totalCost Decimal @default(0) @db.Decimal(14,2)
 allocatedOverhead Decimal @default(0) @db.Decimal(14,2)
 calculatedUnitPrice Decimal @default(0) @db.Decimal(14,2)
 unitPrice Decimal @default(0) @db.Decimal(14,2)
 taxable Boolean @default(false)

 id String @id @default(cuid())
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 sectionId String
 section EstimateSection @relation(fields: [sectionId], references: [id])
 serviceItemId String?
 serviceItem ServiceItem? @relation(fields: [serviceItemId], references: [id])
 name String
 unit Unit
 quantity Decimal @db.Decimal(12,3)
 materialCost Decimal @db.Decimal(14,2)
 laborCost Decimal @db.Decimal(14,2)
 subcontractorCost Decimal @db.Decimal(14,2)
 overheadAllocation Decimal @db.Decimal(14,2)
 markup Decimal @db.Decimal(7,4)
 minimumMargin Decimal @db.Decimal(7,4)
 calculatedPrice Decimal @db.Decimal(14,2)
 sellingPrice Decimal @db.Decimal(14,2)
 overrideReason String?
 overriddenById String?
 overriddenBy User? @relation(fields: [overriddenById], references: [id])
}
model Project {
 id String @id @default(cuid())
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 customerId String
 customer Customer @relation(fields: [customerId], references: [id])
 opportunityId String @unique
 opportunity Opportunity @relation(fields: [opportunityId], references: [id])
 estimateId String
 estimate Estimate @relation(fields: [estimateId], references: [id])
 status ProjectStatus @default(PRE_CONSTRUCTION)
 startDate DateTime?
 estimatedCompletionDate DateTime?
 actualCompletionDate DateTime?
 contractValue Decimal @db.Decimal(14,2)
 estimatedCost Decimal @db.Decimal(14,2)
 actualCost Decimal @db.Decimal(14,2)
 estimatedGrossProfit Decimal @db.Decimal(14,2)
 actualGrossProfit Decimal @db.Decimal(14,2)
 projectManagerId String?
 projectManager User? @relation(fields: [projectManagerId], references: [id])
 tasks ProjectTask[]
}
model ProjectTask {
 id String @id @default(cuid())
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 projectId String
 project Project @relation(fields: [projectId], references: [id])
 title String
 dueAt DateTime?
 completedAt DateTime?
}
model AIAgent {
 id String @id @default(cuid())
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 name String @unique
 provider String?
 model String?
 enabled Boolean @default(false)
 actions AIAction[]
 recommendations AIRecommendation[]
}
model AIAction {
 id String @id @default(cuid())
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 agentId String
 agent AIAgent @relation(fields: [agentId], references: [id])
 type String
 risk Risk
 status ActionStatus @default(PROPOSED)
 reason String
 context Json
 result Json?
 executedAt DateTime?
 approvalRequired Boolean @default(true)
 approval ApprovalRequest?
}
model AIRecommendation {
 id String @id @default(cuid())
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 agentId String
 agent AIAgent @relation(fields: [agentId], references: [id])
 title String
 rationale String
 context Json
 developmentOnly Boolean @default(false)
}
model ApprovalRequest {
 id String @id @default(cuid())
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 actionId String @unique
 action AIAction @relation(fields: [actionId], references: [id])
 status ActionStatus @default(AWAITING_APPROVAL)
 approvedById String?
 approvedBy User? @relation(fields: [approvedById], references: [id])
 decidedAt DateTime?
 reason String?
}

model CatalogPriceHistory {
 id String @id @default(cuid())
 createdAt DateTime @default(now())
 serviceItemId String
 serviceItem ServiceItem @relation(fields:[serviceItemId],references:[id])
 actorId String
 actor User @relation(fields:[actorId],references:[id])
 before Json
 after Json
 reason String
 @@index([serviceItemId,createdAt])
}
model EstimateApproval {
 id String @id @default(cuid())
 createdAt DateTime @default(now())
 estimateId String
 estimate Estimate @relation(fields:[estimateId],references:[id])
 contentVersion Int
 requesterId String
 reasons Json
 status String @default("PENDING")
 reviewerId String?
 reviewer User? @relation(fields:[reviewerId],references:[id])
 rationale String?
 decidedAt DateTime?
 @@index([estimateId,status])
}
model EstimateTemplate {
 id String @id @default(cuid())
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 name String @unique
 category String
 sections Json
 active Boolean @default(true)
 developmentOnly Boolean @default(false)
}
model EstimatorSettings {
 id String @id @default("company")
 updatedAt DateTime @updatedAt
 companyName String @default("Flipas Home Remodeling")
 contactInfo String @default("")
 brandingColor String @default("#172b30")
 terms String @default("")
 significantDiscountThreshold Decimal @default(0) @db.Decimal(7,4)
}
model EstimateCounter {
 id String @id
 value Int @default(0)
}

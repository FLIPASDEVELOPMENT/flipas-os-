}
model User {
 mailWriteConsents MailWriteConsent[]
 financialPolicies FinancialPolicy[]
 estimates Estimate[]
 estimateApprovals EstimateApproval[]
 pricingChanges CatalogPriceHistory[]

 id String @id @default(cuid())
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 email String @unique
 name String

generator client {
 provider = "prisma-client"
 output = "../src/generated/prisma"
}
datasource db {
 provider = "postgresql"
}
enum Role {
 OWNER
 ADMIN
 SALES
 PROJECT_MANAGER
 CREW
 CUSTOMER
}
enum LeadSource {
 WEBSITE
 INSTAGRAM
 FACEBOOK
 GOOGLE
 REFERRAL
 HOME_SHOW
 HOME_DEPOT
 THUMBTACK
 REALTOR
 INVESTOR
 REPEAT_CUSTOMER
 OTHER
}
enum LeadStatus {
 NEW
 CONTACTED
 QUALIFIED
 UNQUALIFIED
 CONVERTED
}
enum Stage {
 NEW
 CONTACTED
 QUALIFYING
 SITE_VISIT_SCHEDULED
 ESTIMATE_IN_PROGRESS
 ESTIMATE_SENT
 FOLLOW_UP
 NEGOTIATION
 WON
 LOST
}
enum ProjectStatus {
 QUALITY_REVIEW
 ON_HOLD
 PLANNING
 PRE_CONSTRUCTION
 MATERIAL_ORDERING
 SCHEDULED
 IN_PROGRESS
 PUNCH_LIST
 COMPLETED
 CANCELLED
}
enum Risk {
 LOW
 MEDIUM
 HIGH
}
enum ActionStatus {
 PROPOSED
 AWAITING_APPROVAL
 APPROVED
 REJECTED
 EXECUTED
 FAILED
}
enum Unit {
